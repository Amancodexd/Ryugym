# -------------------------------------------------------
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# -------------------------------------------------------

NODE_ENV=development

# Server
PORT=3001

# Frontend origin (used for CORS and redirect)
# Local dev: http://127.0.0.1:5500
# GitHub Pages: https://amancodexd.github.io
FRONTEND_ORIGIN=http://127.0.0.1:5500

# eSewa credentials
# Sandbox product code and test secret key (from eSewa docs)
# Production: replace with the code + secret eSewa gives after merchant approval
ESEWA_PRODUCT_CODE=YOUR_ESEWA_PRODUCT_CODE
ESEWA_SECRET_KEY=YOUR_ESEWA_SECRET_KEY

# eSewa endpoints (swap to production URLs when you go live)
# Sandbox form:       https://rc-epay.esewa.com.np/api/epay/main/v2/form
# Production form:    https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Sandbox status:     https://rc.esewa.com.np/api/epay/transaction/status/
# Production status:  https://epay.esewa.com.np/api/epay/transaction/status/
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Public URL of THIS backend (eSewa redirects back here after payment)
# Local:      http://localhost:3001
# Render/Railway: https://your-app-name.onrender.com
BACKEND_PUBLIC_URL=http://localhost:3001
